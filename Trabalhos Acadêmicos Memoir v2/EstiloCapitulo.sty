% ====================================================
% 03. Estilo: Grenn
% ====================================================
\makeatletter
\newcommand{\estiloGlenn}{%

\@ifundefined{@chapapp}{\let\@chapapp\chaptername}{}
\@ifundefined{@mainmatter}{\newif\if@mainmatter \@mainmattertrue}{}

\newlength{\mylen}
\newlength{\myhi}
\newlength{\py}
\newlength{\pyy}
\newlength{\backskip}

\def\mghrulefill##1{\leavevmode\leaders\hrule\@height ##1\hfill\kern\z@}

\def\@makechapterhead##1{%
  \vspace*{-14\p@}%
  {\parindent \z@ \raggedright \normalfont

    % Nome + número
    \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
        \settoheight{\myhi}{{\LARGE\scshape Test}}%
        \setlength{\py}{\baselineskip}%
        \addtolength{\py}{1pt}%
        \addtolength{\py}{\myhi}%
        \setlength{\pyy}{\py}%
        \addtolength{\pyy}{-1pt}%

        \raggedright
        {\large\scshape \@chapapp}\space
        {\Huge \thechapter}%
        \hskip 3pt%
        \mghrulefill{1pt}%
        \rule[-1\pyy]{2pt}{\py}\par\nobreak%
      \fi
    \fi

    \interlinepenalty\@M

    % Título
    \Huge\scshape
    \if@mainmatter
      \addtolength{\pyy}{-4pt}%
      \settoheight{\myhi}{{\LARGE\scshape ##1}}%
      \addtolength{\myhi}{\py}%
      \addtolength{\myhi}{-1pt}%
      \vskip -1\pyy%
      \rule{2pt}{\myhi}%
      \mghrulefill{1pt}\hskip 2pt%
      \raggedleft{\LARGE\scshape ##1}\par\nobreak%
      \vskip 80\p@%
    \else
      \setlength{\py}{25pt}%
      \setlength{\pyy}{\py}%
      \setlength{\backskip}{\py}%
      \addtolength{\backskip}{2pt}%
      \addtolength{\pyy}{1pt}%
      \setlength{\myhi}{\baselineskip}%
      \addtolength{\myhi}{\pyy}%
      \mghrulefill{1pt}%
      \rule[-1\py]{2pt}{\pyy}\par\nobreak%
      \vskip -1\backskip%
      \rule{2pt}{\myhi}%
      \mghrulefill{1pt}\hskip 3pt%
      \raggedleft{\LARGE\scshape ##1}\par\nobreak%
      \vskip 40\p@%
    \fi
  }}

\def\@makeschapterhead##1{%
  \vspace*{-24\p@}%
  {\parindent \z@ \normalfont
    \interlinepenalty\@M
    \setlength{\py}{25pt}%
    \setlength{\pyy}{\py}%
    \setlength{\backskip}{\py}%
    \addtolength{\backskip}{2pt}%
    \addtolength{\pyy}{1pt}%
    \setlength{\myhi}{\baselineskip}%
    \addtolength{\myhi}{\pyy}%
    \mghrulefill{1pt}%
    \rule[-1\py]{2pt}{\pyy}\par\nobreak%
    \vskip -1\backskip%
    \rule{2pt}{\myhi}%
    \mghrulefill{1pt}\hskip 3pt%
    \raggedleft{\LARGE\scshape ##1}\par\nobreak%
    \vskip 40\p@%
  }}
}
\makeatother
