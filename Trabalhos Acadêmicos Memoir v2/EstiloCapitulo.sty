% ====================================================
% 05. Estilo: Bjornstrup
% ====================================================
\makeatletter
\newcommand{\estiloBjornstrup}{%

\@ifundefined{@chapapp}{\let\@chapapp\chaptername}{}
\@ifundefined{@mainmatter}{\newif\if@mainmatter \@mainmattertrue}{}

\newlength{\myhi}
\newlength{\mylen}
\newlength{\py}

\setlength{\myhi}{10pt}
\setlength{\mylen}{\textwidth}
\addtolength{\mylen}{52pt}

\def\@makechapterhead##1{%
  \vspace*{-35\p@}%
  {\parindent \z@ \raggedright \normalfont

    \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
        \settowidth{\py}{{\fontsize{80}{80}\usefont{OT1}{pzc}{m}{n}\selectfont \thechapter}}%
        \addtolength{\py}{99pt}%
        \fboxsep=0pt%
        \colorbox[gray]{.85}{%
          \rule{0pt}{40pt}%
          \parbox[b]{\textwidth}{\hfill}%
        }%
        \kern-\py%
        \raise15pt%
        \hbox{%
          \color[gray]{.5}%
          {\bfseries\scshape\fontsize{18}{30}\selectfont \@chapapp\ }%
          {\fontsize{80}{80}\usefont{OT1}{pzc}{m}{n}\selectfont \thechapter}%
        }\\%
      \fi
    \fi

    \interlinepenalty\@M

    \Huge\scshape
    \if@mainmatter
      \nointerlineskip\raggedright
      \fboxsep=\myhi
      \vskip-1ex
      \colorbox[gray]{.85}{%
        \parbox[t]{\mylen}{\raggedright ##1}%
      }\par\nobreak
    \else
      \fboxsep=0pt
      \colorbox[gray]{.85}{%
        \rule{0pt}{0pt}%
        \parbox[b]{\textwidth}{\kern 30pt}%
      }\\
      \nointerlineskip\centering
      \fboxsep=\myhi
      \colorbox[gray]{.85}{%
        \parbox[t]{\mylen}{\raggedright ##1}%
      }\par\nobreak
    \fi
    \vskip 40\p@
  }}

\def\@makeschapterhead##1{%
  \vspace*{-24\p@}%
  {\parindent \z@ \normalfont
    \interlinepenalty\@M
    \Huge\scshape
    \centering
    \fboxsep=\myhi
    \colorbox[gray]{.85}{%
      \parbox[t]{\mylen}{\centering ##1}%
    }\par\nobreak
    \vskip 40\p@
  }}
}
\makeatother
