%=====================================================
% ----------------ESTILOS DE CAPITULOS----------------
%=====================================================

\newcommand{\espacoReta}{0.3cm}
\newcommand{\espessuraReta}{0.4pt}

%=====================================================
% 1. Estilo Retas paralelas - Capítulos Com Numeração
%=====================================================
\newcommand{\retasParalelas}{%
    \estilocapitulotrue % ← marca que o estilo foi ativado
    \titleformat{\chapter}[display]
    {\bfseries}
    {
        \filleft % Alinha à direita
        \color{black!50!} % Cor Texto + Número
        \large\scshape{\chaptertitlename} 
        \fontsize{50}{50}\selectfont\thechapter 
    } 
    {-2.5ex} % Espaço entre o número e a linha do título
    {
        \titlerule[\espessuraReta]
        \vspace{\espacoReta}   
        \filright
        \LARGE\scshape
        \color{black} % Garante que o Título volte a ser PRETO
    } 
    [
        \vspace{\espacoReta}
        \titleline{\rule{\linewidth}{\espessuraReta}}
    ]
%=====================================================
% 2. Capítulos Sem Numeração
%=====================================================
    \titleformat{name=\chapter, numberless}[display]
    {\bfseries\filcenter}
    {}
    {1ex}
    {
        \titlerule[\espessuraReta]
        \vspace{\espacoReta}   
        \LARGE\scshape
    }
    [
        \vspace{\espacoReta}
        \titleline{\rule{\linewidth}{\espessuraReta}}
    ]
    \titlespacing*{\chapter}{0pt}{-1.5cm}{1.5cm}
}
%=====================================================





%=====================================================
% 1. Estilo Semi-Retangulo - Capítulos Com Numeração
%=====================================================
\newcommand{\semiRetangulo}{%
    \estilocapitulotrue % ← marca que o estilo foi ativado
    \newcommand{\CaixaCapituloNumero}{%
    \noindent
    \begin{tikzpicture}
     \node[
        fill=gray!25,
        text=gray!95,
        font=\fontsize{35}{35}\selectfont\bfseries\itshape,
        minimum width=1.8cm,
        minimum height=1.2cm,
        anchor=east,
        inner sep=0pt
      ]
      (numbox) at (\linewidth,0)
      {
         \raisebox{3pt}{%
         \thechapter}
      };    
     \node[
         anchor=south east, 
         color=black!80, 
         font=\normalfont\scshape\fontsize{14}{14}\selectfont, 
         inner xsep=3pt, 
         yshift=-1.5pt
     ] 
     at (numbox.west) 
     {\chaptertitlename};
     \draw[line width=0.6pt, color=black!30] (numbox.west) -- (0,0);
     \draw[line width=0.6pt, color=black!30] (0,0) -- (0, -0.7cm);
    \end{tikzpicture}%
    }
    \titleformat{\chapter}[display]
      {}
      {\CaixaCapituloNumero} 
      {-15pt}
        {%
          \raggedright % alinha à esquerda 
          \setlength{\leftskip}{0.0cm}  % ajuste fino
          \huge \scshape        % tamanho do titulo 
        }   
      [{
        \vspace{5pt}      
        {\color{black!30}\titlerule[0.6pt]}
      }] 
%=====================================================
% 2. Capítulos Sem Numeração
%=====================================================
    \titleformat{name=\chapter, numberless}[display]
    {\filcenter}
    {}
    {1ex}
    {
        \titlerule[\espessuraReta]
        \vspace{\espacoReta}   
        \Huge\scshape
    }
    [
        \vspace{\espacoReta}
        \titleline{\rule{\linewidth}{\espessuraReta}}
    ]
    \titlespacing*{\chapter}{0pt}{-30pt}{30pt}
    \titlespacing*{name=\chapter,numberless}{0pt}{-41pt}{30pt}
}
